            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"{ musics { id name artist } }\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{graphqlUrl}}",
        "description": "Aponta as proximas chamadas GraphQL para Python na porta 8003."
