    {
      "name": "Listar Musicas",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/xml; charset=utf-8"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <listMusics xmlns=\"music.streaming.soap\"/>\n  </soap:Body>\n</soap:Envelope>",
          "options": {
            "raw": {
              "language": "xml"
            }
          }
        },
        "url": {
          "raw": "{{soapUrl}}",
          "host": [
            "{{soapUrl}}"
          ]
        },
        "description": "Lista as musicas populadas no seed. A resposta deve aparecer como XML puro."
      }
